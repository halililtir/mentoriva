# ===============================
# MENTORIVA ENVIRONMENT VARIABLES
# ===============================
# Bu dosya bir şablondur: `cp .env.example .env.local` ile kopyalayıp doldur.
# Production'da değerler Vercel Dashboard > Settings > Environment Variables'dan girilir.
# ASLA .env.local dosyasını git'e commit etme.

# --- Zorunlu -------------------------------------------------

# Anthropic Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Upstash Redis (kullanıcılar, oturumlar, kota, rate limit, geri bildirim)
# Vercel Dashboard > Storage > Upstash for Redis. Yoksa uygulama bellek deposuna
# düşer: yerelde çalışır ama production'da veri KALICI OLMAZ.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin paneli (/admin) anahtarı — EN AZ 12 karakter, tahmin edilemez olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=

# --- E-posta (kayıt ve şifre sıfırlama kodları) ----------------

# https://resend.com/api-keys
RESEND_API_KEY=
# Resend'de DOĞRULANMIŞ bir alan adından gönderici. Boş bırakılırsa
# onboarding@resend.dev kullanılır ve mailler yalnızca Resend hesap sahibine gider.
RESEND_FROM="Mentoriva <noreply@mentoriva.com.tr>"

# --- Opsiyonel -----------------------------------------------

# Paylaşım kartı izinlerini imzalamak için. Boşsa KV_REST_API_TOKEN kullanılır.
# SHARE_CARD_SECRET=

# Canonical URL, sitemap, robots ve OpenGraph için (sonunda / olmadan)
NEXT_PUBLIC_SITE_URL=https://mentoriva.com.tr

# Yalnızca yerel geliştirme: 1 ise Claude API çağrılmaz, sahte cevaplar akar.
# Production'da (NODE_ENV=production) hiçbir koşulda devreye girmez.
# MENTORIVA_MOCK_AI=1
